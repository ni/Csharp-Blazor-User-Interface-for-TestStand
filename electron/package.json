{
  "name": "teststand-blazorui",
  "version": "0.5.0",
  "description": "TestStand Blazor User Interface",
  "main": "main.js",
  "author": "National Instruments",
  "build": {
    "appId": "com.ni.teststand.blazorui",
    "productName": "TestStandBlazorUI",
    "copyright": "Copyright (c) National Instruments Corporation. All Rights Reserved.",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      "loader.html",
      "error.html",
      "all-components-bundle.min.js",
      "electron-app.css"
    ],
    "directories": {
      "output": "../dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "../Tests/publishWin/Release",
        "to": "app",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/teststand_64bit.ico"
    },
    "publish": null
  },
  "scripts": {
    "start:dev": "npm run publish:debug && cross-env NODE_ENV=development npx electron .",
    "publish:release": "dotnet publish ../src/WebServer/WebServer.csproj -c Release -o ../Tests/publishWin/Release --no-self-contained --os win",
    "publish:debug": "dotnet publish ../src/WebServer/WebServer.csproj -c Debug -o ../Tests/publishWin/Debug --no-self-contained --os win",
    "pack": "npm run publish:release && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "@ni/nimble-components": "^34.3.1"
  }
}
